############################
# Node / Vite / React
############################
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
.vite/
.vite-cache/

############################
# UI build output (keep docs/generation tracked manually)
############################
# Ignore everything under docs/generation EXCEPT committed builds
# (remove this block if you intentionally commit builds)
docs/generation/*
!docs/generation/index.html
!docs/generation/assets/
!docs/generation/assets/**

############################
# Tauri / Rust
############################
# Rust build artifacts
target/
**/target/

# Cargo
Cargo.lock

# Tauri generated files
src-tauri/target/
src-tauri/.cargo/

############################
# OS junk
############################
.DS_Store
Thumbs.db
desktop.ini

############################
# Editor / IDE
############################
.vscode/
.idea/
*.swp
*.swo
*.tmp

############################
# Logs
############################
*.log

############################
# Env files / secrets
############################
.env
.env.*
!.env.example

############################
# Python (agent / CLI safety)
############################
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

############################
# Misc
############################
.cache/
.coverage
